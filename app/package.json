{
  "name": "paham-tka",
  "version": "1.28.0",
  "private": true,
  "description": "Paham TKA — Pembahasan Interaktif TKA Matematika Tingkat Lanjut 2025",
  "author": "Penta Putra Purnomo, S.Pd., Gr.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/check-budget.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc --noEmit && eslint . && stylelint \"src/**/*.css\" && prettier --check . && npm run validate:tokens && npm run verify:content",
    "verify:content": "tsx scripts/verify-content.ts",
    "validate:tokens": "tsx scripts/validate-tokens.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "katex": "0.19.0",
    "motion": "14.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "lucide-static": "1.59.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
